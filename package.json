{
  "name": "hello-doctor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --ignore-pattern tests/lint/fixtures/componente-cliente-proibido.tsx --ignore-pattern tests/lint/fixtures/import-relativo-escapa.tsx --ignore-pattern tests/lint/fixtures/import-dinamico-escapa.ts --ignore-pattern tests/lint/fixtures/reexport-escapa.ts --ignore-pattern tests/lint/fixtures/prologo-diretivas-escapa.tsx --ignore-pattern tests/lint/fixtures/server-action-usa-com-clinica.ts --ignore-pattern tests/lint/fixtures/server-action-usa-com-clinica-namespace.ts --ignore-pattern tests/lint/fixtures/server-action-usa-com-servico.ts --ignore-pattern tests/lint/fixtures/server-action-usa-com-servico-namespace.ts --ignore-pattern tests/lint/fixtures/server-action-usa-com-servico-dinamico.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:efemero": "bash scripts/db-efemero.sh",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "test:rls-smoke": "vitest run tests/rls-smoke"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.47.10",
    "kysely": "0.27.5",
    "next": "15.1.0",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}
