{
  "name": "hello-doctor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --ignore-pattern tests/lint/fixtures/componente-cliente-proibido.tsx --ignore-pattern tests/lint/fixtures/import-relativo-escapa.tsx --ignore-pattern tests/lint/fixtures/import-dinamico-escapa.ts --ignore-pattern tests/lint/fixtures/reexport-escapa.ts --ignore-pattern tests/lint/fixtures/prologo-diretivas-escapa.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:efemero": "bash scripts/db-efemero.sh",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "test:rls-smoke": "vitest run tests/rls-smoke"
  },
  "dependencies": {
    "next": "15.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "kysely": "0.27.5",
    "pg": "8.13.1",
    "next-auth": "5.0.0-beta.25",
    "@node-rs/argon2": "2.0.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/pg": "8.11.10",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.0",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8",
    "tsx": "4.19.2"
  }
}
